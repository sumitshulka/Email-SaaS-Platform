{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "gmail-sync": "node --enable-source-maps ./dist/gmail-sync-runner.mjs",
    "test": "node --import tsx --test test/*.test.mjs",
    "test:postgres-ai-credit-recovery-race": "node --import tsx --test test/postgres-ai-credit-recovery-race.test.mjs",
    "test:postgres-addon-capture-race": "node --import tsx --test test/postgres-addon-capture-race.test.mjs",
    "test:postgres-maintenance-race": "node --import tsx --test test/postgres-maintenance-race.test.mjs",
    "migrate:company-intelligence": "node --import tsx scripts/apply-company-intelligence-migration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.13",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.17.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pg-mem": "^3.0.14",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}

#!/bin/sh
set -eu

is_zero_oid() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

found=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  is_zero_oid "$local_oid" && continue

  if is_zero_oid "${remote_oid:-}"; then
    objects=$(git rev-list --objects "$local_oid")
  else
    objects=$(git rev-list --objects "$local_oid" --not "$remote_oid")
  fi

  matches=$(printf '%s\n' "$objects" | awk '
    index($0, " ") {
      path = tolower(substr($0, index($0, " ") + 1))
      if (path ~ /(^|\/)(client[_-]?secret[^/]*\.json|oauth[^/]*credentials?[^/]*\.json|credentials?\.json|service[_-]?account[^/]*\.json)$/) {
        print substr($0, index($0, " ") + 1)
      }
    }
  ')

  if [ -n "$matches" ]; then
    printf '%s\n' "Push blocked: credential-like JSON file found in history for $local_ref -> $remote_ref:" >&2
    printf '%s\n' "$matches" | sed 's/^/  /' >&2
    found=1
  fi
done

if [ "$found" -ne 0 ]; then
  printf '%s\n' 'Remove the file from every outgoing commit before pushing.' >&2
  exit 1
fi

exit 0
